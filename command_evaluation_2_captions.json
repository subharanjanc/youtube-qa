    },
    {
      "start": 320.24,
      "end": 323.52,
      "text": "the next section, but let's keep it"
    },
    {
      "start": 322.2,
      "end": 326.03999999999996,
      "text": "simple for now."
    },
    {
      "start": 323.52,
      "end": 327.84,
      "text": "This system simply receives a color and"
    },
    {
      "start": 326.04,
      "end": 330.12,
      "text": "produces the text"
    },
    {
      "start": 327.84,
